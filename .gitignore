# Rules for this repository only (code/.gitignore adds a few for code/).

# Generated icon set for the docs site
assets/icons/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments and local settings
.venv/
venv/
env/
.env

# Node / frontend
node_modules/

# Runtime data written by the backend and the CLI
load_tests.db
load_test_results/
loadtest-results/
perf-results/
*.log

# mkdocs build output
/site

# LaTeX build output of the course report (project-report-prototype-stage/)
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
