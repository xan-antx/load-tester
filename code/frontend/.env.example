# Base URL of the Elevate Load Tester backend API.
# Copy this file to .env and adjust as needed.
# Defaults to http://localhost:5000 when unset (local Flask backend).
VITE_API_BASE=http://localhost:5000

# Deployed backend (k8s cluster) — uncomment to target the deployment:
# VITE_API_BASE=http://13.63.14.208:30231
